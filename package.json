{
  "name": "cursor-cat",
  "version": "2.0.0",
  "description": "A 3D cat that chases your mouse pointer around the screen. Windows, macOS and Ubuntu.",
  "private": true,
  "type": "module",
  "main": "app/main.js",
  "desktopName": "cursor-cat.desktop",
  "author": {
    "name": "jaisudhakar"
  },
  "license": "MIT",
  "homepage": "https://github.com/jaisudhakar/charger-pet",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaisudhakar/charger-pet.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:gnome": "node scripts/build-gnome.mjs",
    "sprites": "node tools/sprites/render.mjs",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.jaisudhakar.cursorcat",
    "productName": "Cursor Cat",
    "files": [
      "app/**",
      "shared/**",
      "sprites/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "icon": "app/icons/icon.png",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "app/icons/icon.png",
      "maintainer": "jaisudhakar"
    }
  },
  "devDependencies": {
    "electron": "43.7.5",
    "electron-builder": "26.16.1",
    "three": "0.170.0"
  }
}
